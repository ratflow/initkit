# initkit zshenv - minimal, sourced by every zsh instance (keep it fast)

# UTF-8 fallback: fresh VMs/containers have no locale set, and a non-UTF-8
# locale makes tmux render box-drawing/unicode prompts as underscores.
# C.UTF-8 is always available (glibc >= 2.35, musl) and needs no locale-gen.
if [[ -z ${LANG:-} ]]; then
  export LANG=C.UTF-8
fi

typeset -U path
for _d in "$HOME/.local/bin" "$HOME/.cargo/bin" "$HOME/go/bin"; do
  [[ -d "$_d" ]] && path=("$_d" $path)
done
unset _d

# vcpkg toolchain when installed system-wide (core/cpp-dev.sh, sets/dev-cpp-neovim);
# inert in environments without it
if [[ -z ${VCPKG_ROOT:-} && -d /opt/vcpkg ]]; then
  export VCPKG_ROOT=/opt/vcpkg
  path=("/opt/vcpkg" $path)
fi

if (( $+commands[nvim] )); then
  export EDITOR=nvim
  export VISUAL=nvim
fi
