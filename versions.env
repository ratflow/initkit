# Versions of tools installed from GitHub release binaries.
# "latest" resolves through the releases/latest redirect; pin a concrete
# version (e.g. "v0.55.1") for reproducible installs.
LAZYGIT_VERSION=latest
TREE_SITTER_VERSION=latest
# codelldb (nvim-dap adapter), from vadimcn/codelldb releases (core/cpp-dev.sh)
CODELLDB_VERSION=latest
# vcpkg registry release tag used for /opt/vcpkg (core/cpp-dev.sh); unset or
# "master" would track the tip of the registry instead of a pinned release
VCPKG_VERSION=2026.10.16
